root = true

[*.{sh,bash,bats}]
indent_style = space
indent_size = 2

[*.c]
indent_style = space
indent_size = 2

[bin/*/wget]
indent_style = space
indent_size = 2

# generated by the curl build, kept verbatim
[bin/rg35xxplus/curl-config]
ignore = true

# a makeself archive downloaded by `make build`: it opens with a shebang, so
# shfmt walks it and chokes on the payload
[bin/minui-power-control]
ignore = true

# build output, regenerated by `make release`
[dist/**]
ignore = true
